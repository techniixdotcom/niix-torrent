# Embeds binary/text files into a generated C++ source so the same code path is
# used on every platform (no dependency on Windows .rc resources).
#
#   niix_embed_resources(<output.cpp> NAME <dir-with-files>... )
#
# Usage from CMakeLists: see niix_embed_directory() below. This file is also run
# in script mode (cmake -P) at build time so edits to resources are picked up.

function(niix_embed_directory target out_cpp category dir pattern)
    file(GLOB _files CONFIGURE_DEPENDS "${dir}/${pattern}")
    list(SORT _files)
    add_custom_command(
        OUTPUT  "${out_cpp}"
        COMMAND ${CMAKE_COMMAND}
                "-DOUT=${out_cpp}"
                "-DCATEGORY=${category}"
                "-DDIR=${dir}"
                "-DPATTERN=${pattern}"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        DEPENDS ${_files} "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        COMMENT "Embedding ${category} resources"
        VERBATIM)
    target_sources(${target} PRIVATE "${out_cpp}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB _files "${DIR}/${PATTERN}")
    list(SORT _files)

    set(_body "// Generated by cmake/EmbedResources.cmake - do not edit.\n")
    string(APPEND _body "#include \"core/embeddedresources.hpp\"\n\nnamespace\n{\n")

    set(_index 0)
    set(_table "")
    foreach(_file IN LISTS _files)
        get_filename_component(_name "${_file}" NAME_WE)
        file(READ "${_file}" _hex HEX)
        string(LENGTH "${_hex}" _hexlen)
        math(EXPR _size "${_hexlen} / 2")
        # 0x00,0x01,... with a line break every 24 bytes
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n    " _bytes "${_bytes}")
        string(APPEND _body "    const unsigned char data_${_index}[] = {\n    ${_bytes}0x00\n    };\n")
        string(APPEND _table "        { \"${_name}\", data_${_index}, ${_size} },\n")
        math(EXPR _index "${_index} + 1")
    endforeach()

    string(APPEND _body "\n    const pt::Core::EmbeddedResource table[] = {\n${_table}        { nullptr, nullptr, 0 }\n    };\n}\n\n")
    string(APPEND _body "const pt::Core::EmbeddedResource* pt::Core::Embedded${CATEGORY}()\n{\n    return table;\n}\n")
    file(WRITE "${OUT}" "${_body}")
endif()
